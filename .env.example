# ProjectLink Backend Environment Configuration

PORT=5000
NODE_ENV=production

# MongoDB Connection URL (e.g. MongoDB Atlas cluster in production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/projectlink?retryWrites=true&w=majority
# For local dev: mongodb://localhost:27017/projectlink

# JWT Secret for authentication tokens
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Frontend URL for CORS origin whitelist (e.g. https://your-frontend.vercel.app)
CLIENT_URL=http://localhost:5173

# Upload Directory
UPLOAD_DIR=./uploads

# Google Gemini API Key for Resume Parsing
GEMINI_API_KEY=your_gemini_api_key_here
